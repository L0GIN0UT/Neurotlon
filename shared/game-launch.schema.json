{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neurotlon/game-launch/1",
  "title": "Launcher <-> game files",
  "$defs": {
    "ParticipantCode": { "type": "string", "pattern": "^NT(0[1-9]|[1-9][0-9])$" },
    "Discipline": { "enum": ["darts", "football", "pong"] },
    "SessionId": { "type": "string", "format": "uuid" },
    "Launch": {
      "type": "object",
      "required": ["protocol", "session_id", "discipline", "duration_s", "participants", "bridge", "result_path"],
      "properties": {
        "protocol": { "const": 1 },
        "session_id": { "$ref": "#/$defs/SessionId" },
        "discipline": { "$ref": "#/$defs/Discipline" },
        "duration_s": { "type": "integer", "minimum": 10, "maximum": 3600 },
        "max_points": {
          "type": "integer", "minimum": 1, "maximum": 1000,
          "description": "Лимит очков за секцию (дартс, футбол); нет у понга и при отсутствии связи с сервером."
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["code", "display_name"],
            "properties": {
              "code": { "$ref": "#/$defs/ParticipantCode" },
              "display_name": { "type": ["string", "null"], "maxLength": 24 },
              "side": { "enum": ["left", "right"], "description": "Только понг: сторона и датчик emg_left / emg_right." }
            }
          }
        },
        "bridge": {
          "type": "object",
          "required": ["host", "port"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "result_path": { "type": "string", "minLength": 1 },
        "language": { "const": "ru" },
        "fullscreen": { "type": "boolean" }
      }
    },
    "Entry": {
      "type": "object",
      "required": ["participant_code", "outcome"],
      "properties": {
        "participant_code": { "$ref": "#/$defs/ParticipantCode" },
        "outcome": { "enum": ["completed", "not_completed"] },
        "points": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "wins": { "type": "integer", "minimum": 0, "maximum": 1 },
        "reason": { "enum": ["participant_refused", "health", "equipment", "no_show", "other"] }
      }
    },
    "Result": {
      "type": "object",
      "required": ["protocol", "session_id", "status", "entries"],
      "properties": {
        "protocol": { "const": 1 },
        "session_id": { "$ref": "#/$defs/SessionId" },
        "status": { "enum": ["finished", "aborted"] },
        "entries": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/Entry" } },
        "reason": { "type": "string", "maxLength": 200 }
      },
      "if": { "properties": { "status": { "const": "finished" } } },
      "then": { "properties": { "entries": { "minItems": 1 } } },
      "else": { "required": ["reason"], "properties": { "entries": { "maxItems": 0 } } }
    }
  }
}
