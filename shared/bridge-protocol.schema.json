{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neurotlon/bridge-protocol/1",
  "title": "BCI bridge <-> game message",
  "oneOf": [
    { "$ref": "#/$defs/Hello" },
    { "$ref": "#/$defs/Sample" },
    { "$ref": "#/$defs/Sensor" },
    { "$ref": "#/$defs/Calibration" },
    { "$ref": "#/$defs/Burst" },
    { "$ref": "#/$defs/Calibrate" },
    { "$ref": "#/$defs/Reset" }
  ],
  "$defs": {
    "SignalName": {
      "enum": ["eeg", "emg", "emg_left", "emg_right"]
    },
    "EmgSignalName": {
      "enum": ["emg", "emg_left", "emg_right"]
    },
    "SensorState": {
      "enum": ["connecting", "connected", "disconnected", "emulated"]
    },
    "InvalidReason": {
      "enum": ["artifact", "no_contact", "disconnected", "stale", "not_calibrated"]
    },
    "CalibrationStep": {
      "enum": ["rest", "contract", "cycle", "baseline"]
    },
    "Phase": {
      "enum": ["tense", "relax"]
    },
    "EegMethod": {
      "enum": ["emotions", "alpha"]
    },
    "Feature": {
      "enum": ["burst", "emg_cycle", "baseline_duration", "calibration_state"]
    },
    "Segment": {
      "type": "object",
      "required": ["phase", "s"],
      "properties": {
        "phase": { "$ref": "#/$defs/Phase" },
        "s": { "type": "number", "minimum": 2, "maximum": 15 }
      }
    },
    "Hello": {
      "type": "object",
      "required": ["type", "protocol", "signals"],
      "properties": {
        "type": { "const": "hello" },
        "protocol": { "const": 1 },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "state"],
            "properties": {
              "name": { "$ref": "#/$defs/SignalName" },
              "state": { "$ref": "#/$defs/SensorState" }
            }
          }
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Feature" }
        },
        "eeg_method": { "$ref": "#/$defs/EegMethod" },
        "calibrated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SignalName" }
        }
      },
      "dependentSchemas": {
        "eeg_method": {
          "properties": {
            "signals": {
              "contains": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "const": "eeg" } }
              }
            }
          }
        }
      }
    },
    "Reading": {
      "type": "object",
      "required": ["value", "valid"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "valid": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/InvalidReason" }
      },
      "if": { "properties": { "valid": { "const": false } } },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    },
    "Sample": {
      "type": "object",
      "required": ["type", "t_ms", "signals"],
      "properties": {
        "type": { "const": "sample" },
        "t_ms": { "type": "integer", "minimum": 0 },
        "signals": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/SignalName" },
          "additionalProperties": { "$ref": "#/$defs/Reading" }
        }
      }
    },
    "Sensor": {
      "type": "object",
      "required": ["type", "signal", "state"],
      "properties": {
        "type": { "const": "sensor" },
        "signal": { "$ref": "#/$defs/SignalName" },
        "state": { "$ref": "#/$defs/SensorState" },
        "battery": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "Calibration": {
      "type": "object",
      "required": ["type", "signal", "step", "status"],
      "properties": {
        "type": { "const": "calibration" },
        "signal": { "$ref": "#/$defs/SignalName" },
        "step": { "$ref": "#/$defs/CalibrationStep" },
        "status": { "enum": ["running", "done", "failed"] },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "maxLength": 200 },
        "segment": { "type": "integer", "minimum": 1 },
        "phase": { "$ref": "#/$defs/Phase" },
        "phase_left_s": { "type": "number", "minimum": 0, "maximum": 15 }
      },
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["reason"] }
    },
    "Burst": {
      "type": "object",
      "required": ["type", "signal", "t_ms", "seq"],
      "properties": {
        "type": { "const": "burst" },
        "signal": { "$ref": "#/$defs/EmgSignalName" },
        "t_ms": { "type": "integer", "minimum": 0 },
        "seq": { "type": "integer", "minimum": 0 },
        "rise": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Calibrate": {
      "type": "object",
      "required": ["type", "signal", "step"],
      "properties": {
        "type": { "const": "calibrate" },
        "signal": { "$ref": "#/$defs/SignalName" },
        "step": { "$ref": "#/$defs/CalibrationStep" },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Segment" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["phase"],
                "properties": { "phase": { "const": "tense" } }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["phase"],
                "properties": { "phase": { "const": "relax" } }
              }
            }
          ]
        },
        "duration_s": { "type": "number", "minimum": 5, "maximum": 30 }
      }
    },
    "Reset": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "reset" }
      }
    }
  }
}
