# Copy to .env (same folder as docker-compose.yml) and edit. .env is not committed.

# Name of the admin PC in the hall network; goes into the certificate (make-certs.ps1)
# and into the printed URLs. A short name resolvable on the LAN, or leave "neurotlon.local".
HOST_NAME=neurotlon.local

# Where the backup service writes a copy of the database every minute.
# A USB drive or a shared folder of the spare laptop. Docker Desktop must be allowed to use
# the drive (Settings > Resources > File sharing). Forward slashes, even on Windows.
BACKUP_DIR=E:/neurotlon-backup
